# --- LLM configuration (provider-neutral, OpenAI-compatible API) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- GitHub configuration ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/evolutionary-cicd
GITHUB_EVENT_PATH=

# --- Agent / logging configuration ---
AGENT_LOG_LEVEL=INFO

# When true (default), agents never perform real GitHub writes; they log the
# action that *would* be taken instead. Keep this true for local/demo use.
AGENT_DRY_RUN=true
